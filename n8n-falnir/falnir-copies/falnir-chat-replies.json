        0
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "method": "POST",
        "url": "https://alhnmwwbdydcgcgnwhqw.supabase.co/rest/v1/rpc/claim_chat_replies",
        "jsonBody": "={{ JSON.stringify({ p_branch: \"falnir\", p_limit: 10 }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "rB93QINuNPfEbMaT",
          "name": "Fried King | Supabase (service role)"
        }
      }
    },
    {
      "id": "96ac0220-ccd7-4f62-a704-94c4c2ad9c59",
      "name": "Prepare Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "var r = $json;\nif (!r || !r.id) { return { json: { id: '', send: false, error: 'nothing to send' } }; }\nvar ok = !!r.in_window && String(r.content || '').trim() !== '';\nreturn { json: { id: r.id, to: String(r.phone || ''), text: String(r.content || ''), send: ok,\n  error: ok ? '' : (r.in_window ? 'empty message' : 'outside the 24-hour WhatsApp window: the customer must message first') } };\n"
      }
    },
    {
      "id": "4273b2c6-1529-40fa-8c53-aaf71dd2f3a7",
      "name": "Can Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "s1",
              "leftValue": "={{ $json.send }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9463fde9-ffa2-47e9-8913-8a1f1cf421fa",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [
        880,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.ycloud.com/v2/whatsapp/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: \"+917337687522\", to: \"+\" + String($json.to).replace(/[^0-9]/g, \"\"), type: \"text\", text: { body: $json.text } }) }}",
        "options": {
          "timeout": 20000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "2sHKICxwNID36i9F",
          "name": "Fried King | YCloud API Key"
        }
      }
    },
    {
      "id": "947ac421-2514-4381-a71f-8626ba101d8e",
      "name": "Complete Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "method": "POST",
        "url": "https://alhnmwwbdydcgcgnwhqw.supabase.co/rest/v1/rpc/complete_chat_reply",
        "jsonBody": "={{ (function () {\n  var m = $('Prepare Reply').item.json;\n  var sent = !!m.send && !!$json.id;\n  var err = m.send ? (sent ? '' : JSON.stringify($json.error || $json).slice(0, 400)) : m.error;\n  return JSON.stringify({ p_id: m.id, p_ok: sent, p_error: err });\n})() }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "rB93QINuNPfEbMaT",
          "name": "Fried King | Supabase (service role)"
        }
      }
    }
  ],
