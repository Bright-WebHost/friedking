    {
      "id": "86176ab8-9619-4501-90c1-644ea39434cc",
      "name": "Build OTP Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "\nvar b = $('OTP Webhook').first().json.body || {};\nvar v = $input.first().json;\nvar inWindow = (v === true) || (Array.isArray(v) && v[0] === true) || (v && v.otp_window_open === true);\nvar otp = String(b.otp || '');\nvar to = String(b.phone || '').replace(/[^0-9]/g, '');\nvar outgoing;\nif (inWindow) {\n  outgoing = { type: 'text', text: { body: 'Your Fried King OTP is *' + otp + '*. Enter it on the website to continue.' } };\n} else {\n  outgoing = { type: 'template', template: { name: String(b.template || 'friedking_otp'), language: { code: String(b.lang || 'en') },\n    components: [\n      { type: 'body', parameters: [{ type: 'text', text: otp }] },\n      { type: 'button', sub_type: 'url', index: '0', parameters: [{ type: 'text', text: otp }] }\n    ] } };\n}\nreturn [{ json: { to: to, outgoing: outgoing, via: inWindow ? 'text' : 'template' } }];\n"
      }
    },
    {
      "id": "1b8b0b1b-4238-4d82-b241-e11f6f6aaa6a",
      "name": "Send OTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [
        720,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "method": "POST",
        "url": "https://api.ycloud.com/v2/whatsapp/messages",
        "jsonBody": "={{ JSON.stringify(Object.assign({ from: \"+917337687522\", to: \"+\" + String($json.to).replace(/[^0-9]/g, \"\") }, $json.outgoing)) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "2sHKICxwNID36i9F",
          "name": "Fried King | YCloud API Key"
        }
      }
    },
    {
      "id": "e9af982b-29c5-46dd-9d52-d1aaedaadc22",
