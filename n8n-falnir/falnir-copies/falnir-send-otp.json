      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "\nvar r = $input.first().json || {};\nvar ok = !!(r.id || r.wamid) && !r.error && !r.statusCode;\nreturn [{ json: { ok: ok, via: $('Build OTP Message').first().json.via } }];\n"
      }
    },
    {
      "id": "ac1c86c3-0ddc-40bc-9c41-0b7239589294",
