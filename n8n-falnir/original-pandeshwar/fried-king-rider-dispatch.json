    {
      "id": "97e2e3f4-beb0-4c8f-8e8b-0ec92d752989",
      "name": "Extract Dispatch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ],
      "parameters": {
        "jsCode": "\nvar h = $('Rider Webhook').first().json;\nvar d = h.body || h;\nvar num = String(d.order_number || '').trim();\nvar rp = String(d.rider_phone || '').replace(/[^0-9]/g, '');\nif (rp.length === 10) { rp = '91' + rp; }\nif (num === '' || rp === '') {\n  return [{ json: { error: true, reason: 'order_number and rider_phone are required' } }];\n}\nreturn [{ json: { error: false, order_number: num, rider_phone: rp, rider_id: String(d.rider_id || '') } }];\n"
      }
    },
    {
      "id": "1c81dcfb-ec06-4d6f-9553-ebac03995875",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
