    {
      "id": "7a1d7da2-0c2e-4543-ba7b-a85e4e0cc0bc",
      "name": "Build Rider Note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ],
      "parameters": {
        "jsCode": "\nvar rows = $input.first().json;\nvar o = Array.isArray(rows) ? (rows[0] || null) : (rows || null);\nif (o && typeof o === 'object' && Object.keys(o).length === 0) { o = null; }\nvar ex = $('Extract Dispatch').first().json;\nif (!o) { return [{ json: { skip: true, order_number: ex.order_number } }]; }\n\nvar amt = Number(o.total || 0);\nvar addr = [o.address, o.landmark, o.city, o.pincode].filter(function (x) { return x && String(x).trim() !== ''; }).join(', ');\nvar maps = addr ? ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(addr)) : '';\n\nvar msg = '*New delivery - Fried King*\\n' +\n  'Order: ' + (o.order_number || '') + '\\n' +\n  'Customer: ' + (o.customer_name || 'Guest') + '\\n' +\n  'Phone: ' + (o.customer_phone || '') + '\\n\\n' +\n  'Address: ' + (addr || 'Ask the counter') + '\\n' +\n  (maps ? (maps + '\\n') : '') + '\\n' +\n  'Items: ' + (o.items || '') + '\\n\\n' +\n  '*COLLECT Rs ' + amt + ' IN CASH*\\n' +\n  'Hand the cash to the counter when you return.';\n\nreturn [{ json: { skip: false, rider_phone: ex.rider_phone, message: msg,\n                  order_number: o.order_number, amount: amt } }];\n"
      }
    },
