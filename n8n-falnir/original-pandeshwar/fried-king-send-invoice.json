        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "order_number",
              "value": "=eq.{{ $json.order_number }}"
            },
            {
              "name": "select",
              "value": "order_number,customer_phone,customer_name,total,order_type,status"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
