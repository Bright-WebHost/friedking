    {
      "id": "b2c2890d-5300-4c0c-b74d-aa9f6a49885f",
      "name": "Extract Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "jsCode": "var hook = $('Invoice Webhook').first().json;\nvar d = hook.body || hook;\nvar num = String(d.order_number || '').trim();\nif (!num) { return [{ json: { invalid: true, reason: 'Missing order_number' } }]; }\nreturn [{ json: { invalid: false, order_number: num } }];"
      }
    },
    {
      "id": "4722bc5e-3bf4-4048-8432-984e5c2efd88",
