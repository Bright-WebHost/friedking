    {
      "id": "55fd8a14-eae7-4488-915f-7d9ced1025cb",
      "name": "Valid Order?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1344,
        288
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ Array.isArray($json) && $json.length > 0 && !!$json[0].customer_phone && ['cancelled','declined'].indexOf($json[0].status) === -1 }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          }
        },
        "options": {}
      }
    },
    {
      "id": "45a20eb9-c53a-4575-86ae-7fdf6ca32256",
      "name": "Respond No Order",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1568,
        192
      ],
      "parameters": {
        "options": {
          "responseCode": 404,
          "responseHeaders": {
