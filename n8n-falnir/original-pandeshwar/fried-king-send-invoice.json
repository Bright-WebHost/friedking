    {
      "id": "3dda1304-f26b-478a-9ecc-e7211250f19a",
      "name": "Build Invoice Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        384
      ],
      "parameters": {
        "jsCode": "var order = $json[0];\nvar imgUrl = 'https://staff.brightmedia.tech/webhook/friedking-receipt?order_number=' + encodeURIComponent(order.order_number) + '&key=fk_bWzKMd0MI4U3WEUCAGYlQxcb';\nvar caption = 'Here is your invoice for order ' + order.order_number + '. Total Rs' + order.total + '. Thank you for choosing Fried King!';\nreturn [{ json: { phone: order.customer_phone, order_number: order.order_number, outgoing: { type: 'image', image: { link: imgUrl, caption: caption } } } }];"
      }
    },
    {
      "id": "1fe1c728-b793-4ad0-8e46-0ac73e31b5fd",
      "name": "Send Invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "position": [
        1792,
        384
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.ycloud.com/v2/whatsapp/messages/sendDirectly",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ from: \"+919742175222\", to: \"+\" + String($json.phone).replace(/[^0-9]/g, \"\") }, $json.outgoing)) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "2sHKICxwNID36i9F",
          "name": "Fried King | YCloud API Key"
        }
      }
    },
    {
      "id": "e6e1ca18-b2d0-4caf-9836-442c6b98ec9d",
      "name": "Record Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        384
      ],
      "parameters": {
        "jsCode": "var built = $('Build Invoice Message').first().json;\nvar res = $json;\nvar body = (res && res.body !== undefined) ? res.body : res;\nvar msgId = (body && body.id && body.id) ? body.id : null;\nvar errCode = (body && body.error && body.error.code) || null;\nvar success = !!msgId;\nvar friendlyError = '';\nif (!success) {\n  if (errCode === 131047 || /131047|re-?engagement|24 ?hour/i.test(JSON.stringify(body || {}))) { friendlyError = \"Could not send - this customer hasn't messaged us on WhatsApp in the last 24 hours, so we can't send a free-form invoice. Please share the bill with them directly.\"; }\n  else { friendlyError = 'Could not send the invoice - please try again or share the bill directly.'; }\n}\nreturn [{ json: { success: success, order_number: built.order_number, phone: built.phone, message_id: msgId, error: friendlyError, caption: built.outgoing.image.caption } }];"
      }
    },
