        "jsCode": "var r = $('Verify & Mark Paid (Webhook)').first().json;\nvar b = (r && r.body !== undefined) ? r.body : r;\nvar phone = b.customer_phone || '';\nvar total = b.total != null ? b.total : '';\nvar text = '✅ Payment received — ₹' + total + '. Thanks! We’ll start preparing your order shortly.';\nreturn [{ json: { phone: phone, text: text } }];"
      }
