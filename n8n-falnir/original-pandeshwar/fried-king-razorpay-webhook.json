      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "var item = $input.first();\nvar raw = '';\ntry {\n  var bin = item.binary && item.binary.data;\n  if (bin && bin.data) { raw = Buffer.from(bin.data, 'base64').toString('utf8'); }\n} catch (e) { raw = ''; }\nif (!raw) { raw = JSON.stringify(item.json.body || {}); }\nvar headers = item.json.headers || {};\nvar sig = headers['x-razorpay-signature'] || headers['X-Razorpay-Signature'] || '';\nreturn [{ json: { raw: raw, signature: sig } }];"
      }
    },
    {
      "id": "4dd24ec6-2262-43a0-be83-8b3b273a4c3c",
      "name": "Respond",
