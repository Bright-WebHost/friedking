    {
      "id": "e08b1914-fd30-42a7-b497-a4ebeb5e92ad",
      "name": "Get Pending Blasts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://alhnmwwbdydcgcgnwhqw.supabase.co/rest/v1/outbound_messages?status=eq.pending&kind=eq.blast&order=created_at.asc&limit=5",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
