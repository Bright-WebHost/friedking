        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "rB93QINuNPfEbMaT",
          "name": "Fried King | Supabase (service role)"
        }
      }
    },
    {
      "id": "83ad7276-0ded-47c7-b6c0-d954fd414044",
      "name": "Check Pending",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "jsCode": "var items = $input.all();\nvar valid = items.filter(function (i) { return i && i.json && i.json.id; });\nif (!valid.length) {\n  return []; // Stop execution gracefully when no blasts pending\n}\nreturn valid;"
      }
    },
    {
      "id": "d9b45d9d-c0ab-4357-8a61-df0e920b587b",
      "name": "Loop Over Blasts",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        780,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "1d003015-9cf5-4e82-9357-7ec748025f19",
      "name": "Claim Blast",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://alhnmwwbdydcgcgnwhqw.supabase.co/rest/v1/outbound_messages?id=eq.{{ $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: \"claimed\", processed_at: new Date().toISOString() }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "rB93QINuNPfEbMaT",
          "name": "Fried King | Supabase (service role)"
        }
      }
    },
    {
      "id": "4e295961-7ad1-455b-8b30-1f649855b8e1",
      "name": "Prepare YCloud Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "jsCode": "var m = $('Loop Over Blasts').first().json;\nvar phone = String(m.to_phone || '').replace(/[^0-9]/g, '');\nif (phone.length === 10 && '6789'.indexOf(phone.charAt(0)) !== -1) phone = '91' + phone;\n\nvar template = m.template_name || 'friedking_promo_en';\nvar lang = m.language || 'en';\nvar headerImage = m.header_image || '';\nvar payload = m.payload || {};\nvar customerName = (payload && payload.customerName) || '';\n\nvar components = [];\nif (headerImage) {\n  components.push({\n    type: 'header',\n    parameters: [{ type: 'image', image: { link: headerImage } }]\n  });\n}\nif (customerName) {\n  components.push({\n    type: 'body',\n    parameters: [{ type: 'text', text: customerName }]\n  });\n}\n\nvar sendBody = {\n  from: '+919742175222',\n  to: '+' + phone,\n  type: 'template',\n  template: {\n    name: template,\n    language: { code: lang },\n    components: components\n  }\n};\n\nreturn [{ json: {\n  id: m.id,\n  campaign_id: m.campaign_id,\n  phone: phone,\n  send_body: sendBody\n} }];"
      }
    },
    {
      "id": "3b04c093-c44e-4932-a950-fa9d91beefe0",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.ycloud.com/v2/whatsapp/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.send_body) }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "2sHKICxwNID36i9F",
          "name": "Fried King | YCloud API Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "8076af03-09f7-4558-bc3f-af05a3552975",
      "name": "Parse Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        300
      ],
      "parameters": {
        "jsCode": "var prev = $('Prepare YCloud Payload').first().json;\nvar res = $input.first().json;\n\nvar messageId = '';\ntry { messageId = res.id || ''; } catch (e) {}\n\nvar errorMsg = '';\ntry {\n  if (res.error && res.error.message) errorMsg = res.error.message;\n  else if (res.errorMessage) errorMsg = res.errorMessage;\n  else if (res.message) errorMsg = res.message;\n  else if (typeof res === 'string') errorMsg = res;\n} catch (e) {}\n\nvar status = messageId ? 'done' : 'failed';\n\nreturn [{ json: {\n  id: prev.id,\n  campaign_id: prev.campaign_id,\n  status: status,\n  message_id: messageId,\n  error: String(errorMsg || '').slice(0, 500)\n} }];"
      }
    },
    {
      "id": "ce067f3a-5fe2-4317-b8c0-fdc241ae40a4",
      "name": "Update outbound_messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2080,
        300
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://alhnmwwbdydcgcgnwhqw.supabase.co/rest/v1/outbound_messages?id=eq.{{ $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
