      "name": "Prepare OTP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ],
      "parameters": {
        "jsCode": "function cleanPhone(raw) {\n  var p = String(raw || '').replace(/[^0-9]/g, '');\n  if (p === '') return '';\n  if (p.length === 11 && p.charAt(0) === '0') return '91' + p.substring(1);\n  if (p.length === 10 && '6789'.indexOf(p.charAt(0)) !== -1) return '91' + p;\n  if (p.length === 12 && p.substring(0, 2) === '91') return p;\n  if (p.length >= 11 && p.length <= 15) return p;\n  return '91' + p;\n}\nvar hook = $('OTP Request Webhook').first().json;\nvar d = hook.body || hook;\nvar phone = cleanPhone(d.phone);\nif (!phone) { return [{ json: { invalid: true, reason: 'Enter a valid WhatsApp number' } }]; }\nvar code = String(Math.floor(100000 + Math.random() * 900000));\nvar expires = new Date(Date.now() + 5 * 60000).toISOString();\nreturn [{ json: { invalid: false, phone: phone, code: code, expires_at: expires } }];"
      }
    },
