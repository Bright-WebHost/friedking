      "parameters": {
        "jsCode": "function cleanPhone(raw) {\n  var p = String(raw || '').replace(/[^0-9]/g, '');\n  if (p === '') return '';\n  if (p.length === 11 && p.charAt(0) === '0') return '91' + p.substring(1);\n  if (p.length === 10 && '6789'.indexOf(p.charAt(0)) !== -1) return '91' + p;\n  if (p.length === 12 && p.substring(0, 2) === '91') return p;\n  if (p.length >= 11 && p.length <= 15) return p;\n  return '91' + p;\n}\nvar hook = $('Concern Webhook').first().json;\nvar d = hook.body || hook;\nvar phone = cleanPhone(d.phone);\nvar msg = String(d.message || '').trim();\nvar orderNumber = String(d.order_number || '').trim();\nif (!phone || !msg) { return [{ json: { invalid: true, reason: 'Phone and a message are required' } }]; }\nvar content = '[Concern' + (orderNumber ? ' re ' + orderNumber : '') + '] ' + msg;\nreturn [{ json: { invalid: false, phone: phone, content: content } }];"
