      ],
      "parameters": {
        "method": "GET",
        "url": "https://fk-supabase-ref-pending.supabase.co/rest/v1/orders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "order_number",
              "value": "=eq.{{ $('Rider Webhook').first().json.body.order_number }}"
            },
            {
              "name": "select",
              "value": "order_number,customer_phone,customer_name,address,landmark,pincode,items,total"
            }
