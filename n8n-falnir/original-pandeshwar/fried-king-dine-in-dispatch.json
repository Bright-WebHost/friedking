    {
      "id": "13cdf918-a90b-48c1-a776-84b06c7d73d1",
      "name": "Build Table Receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        448
      ],
      "parameters": {
        "jsCode": "var b = $('Table Close Webhook').first().json.body || {};\nvar phone = String(b.phone || '').replace(/[^0-9]/g, '');\nif (!phone) { return [{ json: { skip: true, deliverable: false, phone: '', message: '' } }]; }\n\nvar recentRows = [];\ntry {\n  var chk = $('Check Recent Inbound (Close)').first().json;\n  var b2 = (chk && chk.body !== undefined) ? chk.body : chk;\n  recentRows = Array.isArray(b2) ? b2 : (b2 ? [b2] : []);\n} catch (e) { recentRows = []; }\nvar hasRecentInbound = recentRows.some(function (r) { return r && r.id; });\n\nvar total = Number(b.total || 0);\nvar msg = 'Thank you for dining with us at Fried King \\u{1F30A}'\n  + '\\n\\nTable ' + (b.table_number || '') + ' · Total ₹' + total\n  + '\\n\\nWe hope to see you again soon. You can order delivery any time right here on this chat.';\nreturn [{ json: { skip: false, deliverable: hasRecentInbound, phone: phone, message: msg } }];"
      }
