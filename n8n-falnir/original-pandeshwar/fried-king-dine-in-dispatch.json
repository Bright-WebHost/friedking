    {
      "id": "216d87a6-eceb-401a-87d6-f18ecaf5cd65",
      "name": "Build Decline Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "var rows = $('Fetch Declined Order').first().json;\nvar o = Array.isArray(rows) ? (rows[0] || null) : rows;\nif (o && typeof o === 'object' && Object.keys(o).length === 0) { o = null; }\nvar body = $('Decline Webhook').first().json.body || {};\nif (!o || !o.customer_phone) { return [{ json: { skip: true, deliverable: false, phone: '', message: '', order_number: body.order_number || '' } }]; }\n\nvar recentRows = [];\ntry {\n  var chk = $('Check Recent Inbound (Decline)').first().json;\n  var b2 = (chk && chk.body !== undefined) ? chk.body : chk;\n  recentRows = Array.isArray(b2) ? b2 : (b2 ? [b2] : []);\n} catch (e) { recentRows = []; }\nvar hasRecentInbound = recentRows.some(function (r) { return r && r.id; });\n\nvar name = o.customer_name ? (' ' + o.customer_name) : '';\nvar reason = String(body.reason || 'We are unable to take this order right now');\nvar msg = 'Hi' + name + ', we are very sorry — we cannot take order ' + o.order_number + ' right now.'\n  + '\\n\\nReason: ' + reason\n  + '\\n\\nNothing has been charged. Please call us on +91 97421 75222 and we will help you sort it out.';\nreturn [{ json: { skip: false, deliverable: hasRecentInbound, phone: o.customer_phone, message: msg, order_number: o.order_number } }];"
      }
    },
