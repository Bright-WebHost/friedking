    {
      "id": "6f95848a-4500-4aa4-b9ef-64a8ba813673",
      "name": "Build Rider Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        224
      ],
      "parameters": {
        "jsCode": "var rows = $input.first().json;\nvar o = Array.isArray(rows) ? (rows[0] || null) : rows;\nvar body = $('Rider Webhook').first().json.body || {};\n\n// Riders are usually saved as a plain 10-digit number. WhatsApp needs the\n// country code, so a bare 10-digit number was silently failing to send.\nfunction waNumber(raw) {\n  var p = String(raw || '').replace(/[^0-9]/g, '');\n  if (p === '') { return ''; }\n  if (p.length === 10 && '6789'.indexOf(p.charAt(0)) !== -1) { return '91' + p; }\n  if (p.length === 11 && p.charAt(0) === '0') { return '91' + p.substring(1); }\n  if (p.length === 12 && p.substring(0, 2) === '91') { return p; }\n  if (p.length >= 11 && p.length <= 15) { return p; }\n  return '91' + p;\n}\n\n// WhatsApp template params reject newlines/tabs and 4+ consecutive spaces\n// (error 132018). Menu item descriptions (e.g. multi-line combo contents)\n// can contain real newlines, so every string going into the template must\n// be flattened to a single line first.\nfunction clean(s) {\n  return String(s || '').replace(/[\\r\\n\\t]+/g, ' ').replace(/ {2,}/g, ' ').trim();\n}\n\nvar rp = waNumber(body.rider_phone);\nif (!o || !rp) { return [{ json: { skip: true, phone: '', message: '' } }]; }\n\nvar addr = clean(o.address || '');\nif (o.landmark) { addr = clean(addr + ', ' + o.landmark); }\nif (o.pincode) { addr = clean(addr + ' - ' + o.pincode); }\nif (addr === '') { addr = 'No address on file - call the customer'; }\n\nvar amt = Number(body.amount || o.total || 0);\nvar itemsClean = clean(o.items || '');\nvar nameClean = clean(o.customer_name || 'Guest');\nvar msg = '\\u{1F6F5} New delivery — ' + o.order_number\n  + '\\n\\n\\u{1F464} ' + nameClean + ' · ' + (o.customer_phone || '')\n  + '\\n\\u{1F4CD} ' + addr\n  + '\\n\\n\\u{1F9FE} ' + itemsClean\n  + '\\n\\n\\u{1F4B5} COLLECT ₹' + amt + ' in cash'\n  + '\\n\\nMark it collected on the dashboard when you are back.';\n\n// Template params for friedking_rider_msg, in order: {{1}} order number,\n// {{2}} customer name, {{3}} customer phone, {{4}} address, {{5}} items,\n// {{6}} amount. 'message' is kept only for execution-log readability.\nreturn [{ json: {\n  skip: false, phone: rp, message: msg, order_number: o.order_number,\n  customer_name: nameClean,\n  customer_phone: o.customer_phone || '',\n  address: addr,\n  items: itemsClean,\n  amount: String(amt)\n} }];"
      }
    },
