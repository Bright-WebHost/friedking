    {
      "id": "3df06212-4485-4cec-8ebb-1fed036aab3b",
      "name": "Build Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        112
      ],
      "parameters": {
        "jsCode": "var runwayRaw = $('Fetch Ingredient Runway').first().json;\nvar runwayBody = (runwayRaw && runwayRaw.body !== undefined) ? runwayRaw.body : runwayRaw;\nvar runway = Array.isArray(runwayBody) ? runwayBody : [];\n\nvar existingRaw = $('Fetch Existing Insights').first().json;\nvar existingBody = (existingRaw && existingRaw.body !== undefined) ? existingRaw.body : existingRaw;\nvar existing = Array.isArray(existingBody) ? existingBody : [];\n\nfunction alreadyFlagged(name) {\n  return existing.some(function (e) { return e.related_table === 'ingredients' && String(e.related_id) === String(name); });\n}\n\nvar candidates = runway.filter(function (r) {\n  return r.days_remaining !== null && r.days_remaining !== undefined && Number(r.days_remaining) < 3 && !alreadyFlagged(r.name);\n}).map(function (r) {\n  return { ingredient_name: r.name, days_remaining: r.days_remaining, current_stock: r.current_stock, unit: r.unit };\n});\n\nreturn [{ json: { candidates: candidates, count: candidates.length } }];"
      }
    },
    {
      "id": "9c5ba6d4-29f9-45ba-92fd-cc7534c5dbcb",
      "name": "Has Candidates?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        896,
        112
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.count }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          }
        },
        "options": {}
      }
    },
    {
      "id": "f14970bb-e9a6-44db-ae3b-dc10a0487894",
      "name": "Write Insights",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1120,
        112
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Ingredients that need attention (less than 3 days of stock left at this week's sales pace):\n{{ JSON.stringify($json.candidates, null, 2) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are reviewing which restaurant ingredients are at risk of running out, based on real stock and consumption data already computed for you - never invent numbers. For each ingredient given, write one natural, concise restock reminder sentence (not a mechanical template) that a manager would actually want to read, mentioning roughly how soon it is expected to run out. Return exactly one insight per ingredient_name given - do not skip any, do not add any ingredient that was not given to you."
        }
      }
    },
    {
      "id": "a567fbb5-e118-44dd-ad03-4612471e6d7b",
      "name": "OpenAI Model Insights",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1136,
        336
      ],
      "parameters": {
        "model": {
