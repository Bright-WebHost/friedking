        }
      }
    },
    {
      "id": "10d5127d-427e-49c8-a916-d4efb8e1d81f",
      "name": "Insights Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1264,
        336
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\"insights\":[{\"ingredient_name\":\"Garlic\",\"text\":\"Garlic is down to about a day and a half of stock at this week's pace - worth restocking before tomorrow's service.\"}]}"
      }
    },
    {
      "id": "be872480-c171-4d15-8a84-4f1c28b2491e",
      "name": "Build Reminder Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        112
      ],
      "parameters": {
        "jsCode": "var cand = $('Build Candidates').first().json.candidates || [];\nvar llmOut = [];\ntry { llmOut = $('Write Insights').first().json.output.insights || []; } catch (e) { llmOut = []; }\n\nvar tomorrow8am = (function () {\n  var d = new Date();\n  d.setUTCDate(d.getUTCDate() + 1);\n  d.setUTCHours(2, 30, 0, 0); // 08:00 IST = 02:30 UTC\n  return d.toISOString();\n})();\n\nvar out = [];\nllmOut.forEach(function (ins) {\n  var match = cand.find(function (c) { return c.ingredient_name === ins.ingredient_name; });\n  if (!match) return;\n  out.push({\n    text: String(ins.text || '').trim() || (match.ingredient_name + ' is running low - restock soon.'),\n    type: 'ai',\n    status: 'pending',\n    source: 'automation',\n    related_table: 'ingredients',\n    related_id: match.ingredient_name,\n    due_at: tomorrow8am\n  });\n});\n\nreturn [{ json: { rows: out } }];"
      }
    },
