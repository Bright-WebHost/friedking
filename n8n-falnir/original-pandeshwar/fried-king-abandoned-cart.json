    {
      "id": "c3b7c26e-eeaa-4152-83f5-5bd89410f598",
      "name": "Build Nudge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        240
      ],
      "parameters": {
        "jsCode": "\nfunction rs(n){ return 'Rs ' + Number(n||0).toLocaleString('en-IN'); }\nvar c = $input.first().json;\nif (!c || !c.phone) { return [{ json: { skip: true } }]; }\nvar items = Array.isArray(c.items) ? c.items : [];\nvar names = items.slice(0, 3).map(function (i) { return i.name; }).join(', ');\nvar more = items.length > 3 ? (' and ' + (items.length - 3) + ' more') : '';\nvar msg = 'You left ' + (names || 'a few items') + more + ' in your cart (' + rs(c.total) + ').\\n\\n' +\n  'Still hungry? Tap below and we will get it moving.';\nreturn [{ json: { skip: false, phone: c.phone, outgoing: { type: 'interactive', interactive: {\n  type: 'cta_url', body: { text: msg },\n  action: { name: 'cta_url', parameters: { display_text: 'Finish Order',\n    url: 'https://FK_MENU_URL_PENDING?ph=' + c.phone } } } } } }];\n"
      }
    },
    {
      "id": "61577927-bfc3-449b-b33d-0f0b3fc31fc6",
      "name": "Send Nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "position": [
        224,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.ycloud.com/v2/whatsapp/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ from: \"+919742175222\", to: \"+\" + String($json.phone).replace(/[^0-9]/g, \"\") }, $json.outgoing)) }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "2sHKICxwNID36i9F",
          "name": "Fried King | YCloud API Key"
        }
      }
    },
    {
      "id": "ceef352c-897c-49d7-8f09-71d147e98ffa",
