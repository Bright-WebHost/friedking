        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: \"+919742175222\", to: \"+\" + String($json.phone).replace(/[^0-9]/g, \"\"), type: \"text\", text: { body: $json.message } }) }}",
