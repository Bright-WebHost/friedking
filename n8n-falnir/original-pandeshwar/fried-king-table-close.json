    {
      "id": "28e117a8-c88f-48ed-be65-20f3dd287322",
      "name": "Extract Table",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ],
      "parameters": {
        "jsCode": "\nvar h = $('Table Close Webhook').first().json;\nvar d = h.body || h;\nvar phone = String(d.phone || '').replace(/[^0-9]/g, '');\nif (phone.length === 10) { phone = '91' + phone; }\nvar total = Number(d.total || 0);\nvar table = String(d.table_number || '');\nvar name = String(d.customer_name || '');\nvar first = name ? (' ' + name.split(' ')[0]) : '';\nvar msg = 'Thank you for dining with us' + first + '! \\u{1F30A}\\n\\n' +\n  'Table ' + table + ' \\u00b7 Total paid: Rs ' + total + '\\n\\n' +\n  'How was your meal? Reply with a number from 1 to 5.\\n(1 = poor, 5 = excellent)';\nreturn [{ json: { has_phone: phone.length >= 11, phone: phone, message: msg,\n                  table_number: table, total: total,\n                  session_id: String(d.session_id || '') } }];\n"
      }
    },
    {
      "id": "e8ed4fd7-a594-469f-a489-53b96744667c",
      "name": "Has Phone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.has_phone }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "2c7887e1-3343-4d04-9d19-c1f6168ea431",
      "name": "WhatsApp Thanks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "position": [
        672,
        0
